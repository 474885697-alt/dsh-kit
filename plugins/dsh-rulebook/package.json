{
  "name": "dsh-rulebook",
  "version": "0.1.0",
  "description": "把桌游或跑团规则书（docx/txt/md）抽成结构化 JSON：章节、编号条款、关键词表与数值，并检查缺失数值和重复条目。",
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./package.json": "./package.json" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "engines": { "node": ">=20" },
  "files": ["lib", "cordis.patch.yml", "README.md"],
  "keywords": ["dsh", "dsh-plugin", "rulebook", "docx", "tabletop"],
  "license": "MIT"
}